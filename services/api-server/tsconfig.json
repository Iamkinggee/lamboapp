{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "downlevelIteration": true,
    "baseUrl": "./src",
    "paths": {
      "../models/*": ["models/*"]
    }
  },

  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*", "src/types/**/*.d.ts"],  // ← add this

}